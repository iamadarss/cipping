# ==============================================================================
# UpClip Studio - Environment Configuration Template
# Copy this file to '.env' and fill in your actual credentials.
# Command: cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud OAuth 2.0 Credentials (Required for YouTube Desk / Auto-Publishing)
# ------------------------------------------------------------------------------
# Create a project at: https://console.cloud.google.com/
# Enable the YouTube Data API v3.
# Create OAuth 2.0 Client ID (Web Application).
# Add Authorized Redirect URI: http://127.0.0.1:5000/youtube/callback
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/youtube/callback

# ------------------------------------------------------------------------------
# 2. Flask Application Security (Recommended in production)
# ------------------------------------------------------------------------------
SECRET_KEY=upclip-studio-change-this-in-production-secure-random-key

# ------------------------------------------------------------------------------
# 3. Optional Custom Binary Executables
# ------------------------------------------------------------------------------
# By default, UpClip Studio detects ffmpeg and ffprobe from your system PATH,
# or from the local 'bin/' directory (bin/ffmpeg.exe, bin/ffprobe.exe).
# Uncomment and customize only if FFmpeg is installed in a non-standard location:
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe
